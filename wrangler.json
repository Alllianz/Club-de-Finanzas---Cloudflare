  "main": "worker/index.ts",
  "triggers": {
    "crons": ["* * * * *"]
  },
  "assets": {
    "directory": "./out",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clubdefinanzas-db",
