# Entorno y URLs
APP_ENV=development
NODE_ENV=development
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Base de datos PostgreSQL (Docker o Cloud)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/clubdefinanzas-db?schema=public

# Autenticación y Seguridad
JWT_SECRET=dev-secret-change-me-club-finanzas
SESSION_EXPIRATION_DAYS=30
OTP_EXPIRATION_MINUTES=15

# Admin Seed inicial (al correr npm run prisma:seed)
SEED_ADMIN_EMAIL=mateoyastor60@gmail.com
SEED_ADMIN_FULLNAME=Mateo Yastor

# Envío de Emails (Brevo) - Opcional en desarrollo local (muestra OTP en consola si está vacío)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=noreply@clubdefinanzasuba.com
BREVO_SENDER_NAME=Club de Finanzas UBA

# APIs Financieras
ALPHA_VANTAGE_API_KEY=
ALPHA_VANTAGE_BASE_URL=https://www.alphavantage.co/query
ARGENTINA_DATOS_BASE_URL=https://api.argentinadatos.com

# Almacenamiento de Archivos (Cloudflare R2 / AWS S3)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=clubdefinanzas
R2_S3_ENDPOINT=
R2_PUBLIC_BASE_URL=https://assets.clubdefinanzasuba.com
